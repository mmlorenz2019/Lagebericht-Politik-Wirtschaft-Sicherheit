{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/period-report.schema.json",
  "title": "Persönlicher Lagebericht – Zeitraumbericht",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "periodType", "periodStart", "periodEnd", "generatedAt", "status", "overallSummary", "countries", "sourceReportDates", "missingReportDates"],
  "properties": {
    "schemaVersion": {"const": 3},
    "periodType": {"enum": ["week", "month"]},
    "periodStart": {"type": "string", "format": "date"},
    "periodEnd": {"type": "string", "format": "date"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["complete", "partial"]},
    "overallSummary": {"type": "array", "minItems": 1, "maxItems": 15, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "countries": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/country"}},
    "sourceReportDates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "date"}},
    "missingReportDates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "date"}}
  },
  "$defs": {
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "reasonDe"],
      "properties": {
        "score": {"type": "integer", "minimum": 0, "maximum": 3},
        "reasonDe": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "titleOriginal", "url", "publishedAt"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "type": {"type": "string", "minLength": 1, "maxLength": 100},
        "titleOriginal": {"type": "string", "minLength": 1, "maxLength": 300},
        "url": {"type": "string", "format": "uri", "maxLength": 2048},
        "publishedAt": {"type": "string", "format": "date-time"}
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "headlineDe", "summaryDe", "contextDe", "additionalImportant", "germanyRelevance", "overallSignificance", "sourceBasis", "limitations", "sources"],
      "properties": {
        "id": {"enum": ["politics_society", "economy_technology", "foreign_security"]},
        "status": {"enum": ["published", "no_major_development", "unavailable"]},
        "headlineDe": {"type": "string", "maxLength": 180},
        "summaryDe": {"type": "array", "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "contextDe": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "additionalImportant": {"type": ["string", "null"], "maxLength": 500},
        "germanyRelevance": {"anyOf": [{"$ref": "#/$defs/rating"}, {"type": "null"}]},
        "overallSignificance": {"anyOf": [{"$ref": "#/$defs/rating"}, {"type": "null"}]},
        "sourceBasis": {"enum": ["multiple", "single", "none"]},
        "limitations": {"type": "array", "uniqueItems": true, "items": {"enum": ["paywall", "feed_only", "single_source", "source_disagreement", "technical_failure"]}},
        "sources": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/source"}}
      }
    },
    "country": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "sections"],
      "properties": {
        "id": {"enum": ["usa", "china", "montenegro", "eu"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 30},
        "sections": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/category"}}
      }
    }
  }
}
